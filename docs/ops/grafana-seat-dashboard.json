   },
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (increase(lcars_seat_turns_total{job=\"lcars\"}[1d]))",
     "legendFormat": "{{outcome}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "increase(lcars_orders_total{job=\"lcars\"}[1d])",
     "legendFormat": "orders",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 14,
   "title": "Turn time p50 / p90 (24h)",
   "type": "timeseries",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 36,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (increase(lcars_seat_turn_seconds_bucket{job=\"lcars\"}[1d])))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",

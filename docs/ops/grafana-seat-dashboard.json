{
 "title": "LCARS: the seat and the job line",
 "uid": "lcars-seat",
 "tags": [
  "lcars"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "description": "The crew's seat, job line and deploys (docs/ops/seat-metrics.md). Import it and pick the Grafana Cloud Prometheus data source.",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "label": "Data source",
    "current": {}
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "title": "Task time p50 (24h)",
   "type": "stat",
   "description": "From an order to the engineer's report (the turn that yields), over the last day.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (increase(lcars_task_seconds_bucket{job=\"lcars\"}[1d])))",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 2,
   "title": "Task time p90 (24h)",
   "type": "stat",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.9, sum by (le) (increase(lcars_task_seconds_bucket{job=\"lcars\"}[1d])))",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "title": "Seat wait p50 (24h)",
   "type": "stat",
   "description": "From a place in the seat's line to the seat.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (increase(lcars_seat_wait_seconds_bucket{job=\"lcars\"}[1d])))",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "title": "Metrics age",
   "type": "stat",
   "description": "Seconds since engineer.py last wrote the file; reap writes it every 5 minutes, so over ~600 means reap or the crew's state is stuck.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - lcars_eng_metrics_timestamp_seconds{job=\"lcars\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 600
       },
       {
        "color": "red",
        "value": 1800
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "title": "Task time, rolling day",
   "type": "timeseries",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (increase(lcars_task_seconds_bucket{job=\"lcars\"}[1d])))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.9, sum by (le) (increase(lcars_task_seconds_bucket{job=\"lcars\"}[1d])))",
     "legendFormat": "p90",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "C",
     "expr": "increase(lcars_task_seconds_sum{job=\"lcars\"}[1d]) / increase(lcars_task_seconds_count{job=\"lcars\"}[1d])",
     "legendFormat": "mean",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "title": "Time waiting for the seat, rolling day",
   "type": "timeseries",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (increase(lcars_seat_wait_seconds_bucket{job=\"lcars\"}[1d])))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.9, sum by (le) (increase(lcars_seat_wait_seconds_bucket{job=\"lcars\"}[1d])))",
     "legendFormat": "p90",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "C",
     "expr": "increase(lcars_seat_wait_seconds_sum{job=\"lcars\"}[1d])",
     "legendFormat": "total waited",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "title": "Seat line",
   "type": "timeseries",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "lcars_seat_queue_length{job=\"lcars\"}",
     "legendFormat": "queued",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "lcars_seat_held{job=\"lcars\"}",
     "legendFormat": "seat held",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "C",
     "expr": "lcars_seat_waiting_answer{job=\"lcars\"}",
     "legendFormat": "waiting on an answer",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "D",
     "expr": "lcars_engineers_working{job=\"lcars\"}",
     "legendFormat": "working",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "E",
     "expr": "lcars_engineers_on_duty{job=\"lcars\"}",
     "legendFormat": "on duty",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "title": "Job line",
   "type": "timeseries",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "lcars_jobs_queued{job=\"lcars\"}",
     "legendFormat": "queued",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "lcars_jobs_running{job=\"lcars\"}",
     "legendFormat": "running",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "C",
     "expr": "lcars_deploy_running{job=\"lcars\"}",
     "legendFormat": "deploy running",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "D",
     "expr": "lcars_no1_inbox_pending{job=\"lcars\"}",
     "legendFormat": "No.1 inbox",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "title": "Job outcomes per day",
   "type": "timeseries",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (increase(lcars_jobs_total{job=\"lcars\"}[1d]))",
     "legendFormat": "{{outcome}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 10,
   "title": "Job wait and run p90 (24h)",
   "type": "timeseries",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.9, sum by (le) (increase(lcars_job_wait_seconds_bucket{job=\"lcars\"}[1d])))",
     "legendFormat": "wait p90",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.9, sum by (le, outcome) (increase(lcars_job_run_seconds_bucket{job=\"lcars\"}[1d])))",
     "legendFormat": "run p90 {{outcome}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "title": "Deploy time (7d)",
   "type": "timeseries",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (increase(lcars_deploy_seconds_bucket{job=\"lcars\",outcome=\"done\"}[7d])))",
     "legendFormat": "p50 done",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.9, sum by (le) (increase(lcars_deploy_seconds_bucket{job=\"lcars\",outcome=\"done\"}[7d])))",
     "legendFormat": "p90 done",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 12,
   "title": "Deploys and rollbacks per day",
   "type": "timeseries",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (increase(lcars_deploys_total{job=\"lcars\"}[1d]))",
     "legendFormat": "deploy {{outcome}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "increase(lcars_rollbacks_total{job=\"lcars\"}[1d])",
     "legendFormat": "rollbacks",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 13,
   "title": "Turns per day, by how they ended",
   "type": "timeseries",
   "description": "",
   "datasource": {
    "type": "prometheus",

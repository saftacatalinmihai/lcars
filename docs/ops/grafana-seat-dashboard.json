     "legendFormat": "p90",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.9, sum by (le) (increase(lcars_inbox_delivery_seconds_bucket{job=\"lcars\"}[1d])))",
